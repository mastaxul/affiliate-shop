<!DOCTYPE html>
<html lang="ms">
<head>
<meta charset="UTF-8">
<meta name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover">

<meta name="theme-color" content="#020204">

<title>THE DARK COUNTDOWN</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html, body {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #020204;
    color: #fff;
    font-family: Arial, Helvetica, sans-serif;
}

body {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    background:
        radial-gradient(circle at 50% 55%,
            rgba(70, 70, 85, .12) 0%,
            rgba(10, 10, 15, .18) 25%,
            #020204 70%);
}

/* =========================
   BACKGROUND
========================= */

.background {
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
}

.moon {
    position: absolute;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    top: 7%;
    left: 50%;
    transform: translateX(-50%);
    background:
        radial-gradient(circle at 35% 30%,
            #3b3b42,
            #17171d 45%,
            #050507 75%);
    box-shadow:
        0 0 80px rgba(130,130,150,.08);
    opacity: .45;
}

.fog {
    position: absolute;
    width: 160%;
    height: 35%;
    left: -30%;
    bottom: 0;
    background:
        radial-gradient(ellipse,
            rgba(90,90,100,.12),
            transparent 70%);
    filter: blur(30px);
    animation: fogMove 18s ease-in-out infinite alternate;
}

@keyframes fogMove {
    from {
        transform: translateX(-5%);
    }
    to {
        transform: translateX(5%);
    }
}

/* =========================
   LIGHTNING
========================= */

.lightning {
    position: fixed;
    inset: 0;
    background: white;
    opacity: 0;
    pointer-events: none;
    z-index: 20;
}

.lightning.flash {
    animation: flash .45s ease-out;
}

@keyframes flash {
    0%   { opacity: 0; }
    8%   { opacity: .25; }
    12%  { opacity: 0; }
    20%  { opacity: .08; }
    27%  { opacity: 0; }
    100% { opacity: 0; }
}

/* =========================
   STARS / PARTICLES
========================= */

#particles {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 1;
}

.particle {
    position: absolute;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: #aaa;
    opacity: .25;
    animation: floatParticle linear infinite;
}

@keyframes floatParticle {
    from {
        transform: translateY(20px);
        opacity: 0;
    }

    20% {
        opacity: .35;
    }

    80% {
        opacity: .15;
    }

    to {
        transform: translateY(-120px);
        opacity: 0;
    }
}

/* =========================
   MAIN
========================= */

.main {
    position: relative;
    z-index: 5;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 20px;
}

/* =========================
   TITLE
========================= */

.title {
    position: relative;
    text-align: center;
    margin-bottom: 30px;
    letter-spacing: 8px;
    text-transform: uppercase;
    font-size: clamp(20px, 4vw, 38px);
    font-weight: 900;
    color: #d7d7dc;
    text-shadow:
        0 0 8px rgba(255,255,255,.2),
        0 0 25px rgba(255,255,255,.05);
}

.subtitle {
    margin-top: 8px;
    font-size: 10px;
    letter-spacing: 4px;
    color: #777780;
}

/* =========================
   PYRAMID
========================= */

.pyramid-area {
    position: relative;
    width: min(360px, 72vw);
    height: min(300px, 55vw);
    display: flex;
    justify-content: center;
    align-items: center;
}

.pyramid-glow {
    position: absolute;
    width: 60%;
    height: 60%;
    background: rgba(120,120,140,.07);
    filter: blur(45px);
    border-radius: 50%;
}

.pyramid {
    position: relative;
    width: 0;
    height: 0;
    border-left: 145px solid transparent;
    border-right: 145px solid transparent;
    border-bottom: 230px solid #030304;
    filter:
        drop-shadow(0 0 12px rgba(0,0,0,.9))
        drop-shadow(0 20px 35px rgba(0,0,0,.9));
}

/* Pyramid left/right illusion */

.pyramid::before {
    content: "";
    position: absolute;
    left: -145px;
    top: 0;
    width: 290px;
    height: 230px;

    background:
        linear-gradient(
            120deg,
            #16161b 0%,
            #07070a 42%,
            #010102 43%,
            #000 100%
        );

    clip-path: polygon(
        50% 0,
        0 100%,
        50% 100%
    );

    opacity: .9;
}

.pyramid::after {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    width: 290px;
    height: 230px;

    background:
        linear-gradient(
            240deg,
            #101015 0%,
            #030304 50%,
            #000 100%
        );

    clip-path: polygon(
        50% 0,
        50% 100%,
        100% 100%
    );

    opacity: .95;
}

/* Eye */

.eye {
    position: absolute;
    z-index: 10;
    top: 34%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(45deg);
    width: 42px;
    height: 42px;
    border: 2px solid #666;
    background: #050507;
    box-shadow:
        0 0 15px rgba(255,255,255,.06);
}

.eye::after {
    content: "";
    position: absolute;
    width: 12px;
    height: 12px;
    background: #aaa;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    box-shadow:
        0 0 12px rgba(255,255,255,.6);
}

/* =========================
   COUNTDOWN
========================= */

.countdown {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 5px;
}

.unit {
    min-width: 78px;
    text-align: center;
}

.number {
    font-size: clamp(27px, 6vw, 52px);
    font-weight: 800;
    letter-spacing: 2px;
    line-height: 1;
    color: #eeeeef;
    text-shadow:
        0 0 10px rgba(255,255,255,.1);
}

.label {
    margin-top: 8px;
    font-size: 9px;
    letter-spacing: 3px;
    color: #66666e;
    text-transform: uppercase;
}

.separator {
    font-size: 32px;
    color: #38383f;
    margin-top: 3px;
}

/* =========================
   FOOTER
========================= */

.warning {
    margin-top: 30px;
    color: #4e4e56;
    font-size: 9px;
    letter-spacing: 3px;
    text-align: center;
    text-transform: uppercase;
}

.status {
    margin-top: 8px;
    color: #29292f;
    font-size: 8px;
    letter-spacing: 2px;
}

/* =========================
   MOBILE
========================= */

@media (max-width: 600px) {

    .moon {
        width: 220px;
        height: 220px;
    }

    .title {
        letter-spacing: 5px;
        margin-bottom: 15px;
    }

    .subtitle {
        font-size: 8px;
        letter-spacing: 2px;
    }

    .pyramid-area {
        height: 210px;
        margin-bottom: 10px;
    }

    .pyramid {
        border-left-width: 105px;
        border-right-width: 105px;
        border-bottom-width: 170px;
    }

    .pyramid::before,
    .pyramid::after {
        width: 210px;
        height: 170px;
        left: -105px;
    }

    .eye {
        width: 32px;
        height: 32px;
    }

    .eye::after {
        width: 9px;
        height: 9px;
    }

    .countdown {
        gap: 7px;
    }

    .unit {
        min-width: 55px;
    }

    .number {
        font-size: 27px;
    }

    .label {
        font-size: 7px;
        letter-spacing: 1.5px;
    }

    .separator {
        font-size: 20px;
    }

    .warning {
        margin-top: 18px;
    }
}

@media (max-height: 700px) {

    .title {
        margin-bottom: 8px;
    }

    .pyramid-area {
        height: 160px;
    }

    .pyramid {
        transform: scale(.7);
    }

    .warning {
        margin-top: 10px;
    }
}
</style>
</head>

<body>

<div class="background">

    <div class="moon"></div>

    <div class="fog"></div>

    <div id="particles"></div>

</div>

<div class="lightning" id="lightning"></div>

<main class="main">

    <div class="title">
        THE DARK COUNTDOWN

        <div class="subtitle">
            THE CYCLE MUST CONTINUE
        </div>
    </div>

    <div class="pyramid-area">

        <div class="pyramid-glow"></div>

        <div class="pyramid">

            <div class="eye"></div>

        </div>

    </div>

    <div class="countdown">

        <div class="unit">
            <div class="number" id="years">02</div>
            <div class="label">Years</div>
        </div>

        <div class="separator">:</div>

        <div class="unit">
            <div class="number" id="months">07</div>
            <div class="label">Months</div>
        </div>

        <div class="separator">:</div>

        <div class="unit">
            <div class="number" id="days">06</div>
            <div class="label">Days</div>
        </div>

        <div class="separator">:</div>

        <div class="unit">
            <div class="number" id="hours">06</div>
            <div class="label">Hours</div>
        </div>

        <div class="separator">:</div>

        <div class="unit">
            <div class="number" id="minutes">06</div>
            <div class="label">Minutes</div>
        </div>

        <div class="separator">:</div>

        <div class="unit">
            <div class="number" id="seconds">09</div>
            <div class="label">Seconds</div>
        </div>

    </div>

    <div class="warning">
        WHEN THE CLOCK ENDS — THE CYCLE BEGINS AGAIN
    </div>

    <div class="status" id="status">
        SYSTEM ACTIVE
    </div>

</main>

<script>

/* ==========================================
   DARK COUNTDOWN
   2 YEARS 7 MONTHS 6 DAYS
   6 HOURS 6 MINUTES 9 SECONDS
========================================== */

const ORIGINAL = {
    years: 2,
    months: 7,
    days: 6,
    hours: 6,
    minutes: 6,
    seconds: 9
};

let targetTime;


/* ==========================================
   SET COUNTDOWN
========================================== */

function createTarget() {

    const now = new Date();

    targetTime = new Date(now);

    targetTime.setFullYear(
        targetTime.getFullYear() + ORIGINAL.years
    );

    targetTime.setMonth(
        targetTime.getMonth() + ORIGINAL.months
    );

    targetTime.setDate(
        targetTime.getDate() + ORIGINAL.days
    );

    targetTime.setHours(
        targetTime.getHours() + ORIGINAL.hours
    );

    targetTime.setMinutes(
        targetTime.getMinutes() + ORIGINAL.minutes
    );

    targetTime.setSeconds(
        targetTime.getSeconds() + ORIGINAL.seconds
    );
}


/* ==========================================
   UPDATE COUNTDOWN
========================================== */

function updateCountdown() {

    const now = new Date();

    let difference = targetTime - now;

    if (difference <= 0) {

        resetCountdown();

        return;
    }

    let totalSeconds =
        Math.floor(difference / 1000);

    const seconds =
        totalSeconds % 60;

    totalSeconds =
        Math.floor(totalSeconds / 60);

    const minutes =
        totalSeconds % 60;

    totalSeconds =
        Math.floor(totalSeconds / 60);

    const hours =
        totalSeconds % 24;

    const days =
        Math.floor(totalSeconds / 24);


    /*
       Kiraan tahun/bulan sebenar
       berdasarkan calendar.
    */

    let temp = new Date(now);

    let years = 0;
    let months = 0;

    while (true) {

        let next = new Date(temp);

        next.setFullYear(
            next.getFullYear() + 1
        );

        if (next <= targetTime) {

            temp = next;
            years++;

        } else {

            break;
        }
    }

    while (true) {

        let next = new Date(temp);

        next.setMonth(
            next.getMonth() + 1
        );

        if (next <= targetTime) {

            temp = next;
            months++;

        } else {

            break;
        }
    }

    const remainingDays =
        Math.floor(
            (targetTime - temp) /
            (1000 * 60 * 60 * 24)
        );

    setText("years", years);
    setText("months", months);
    setText("days", remainingDays);
    setText("hours", hours);
    setText("minutes", minutes);
    setText("seconds", seconds);
}


/* ==========================================
   NUMBER FORMAT
========================================== */

function setText(id, value) {

    document.getElementById(id).textContent =
        String(value).padStart(2, "0");
}


/* ==========================================
   AUTO RESET
========================================== */

function resetCountdown() {

    document.getElementById("status")
        .textContent = "CYCLE RESETTING...";

    createTarget();

    setTimeout(() => {

        document.getElementById("status")
            .textContent = "SYSTEM ACTIVE";

    }, 1200);
}


/* ==========================================
   PARTICLES
========================================== */

function createParticles() {

    const container =
        document.getElementById("particles");

    for (let i = 0; i < 70; i++) {

        const particle =
            document.createElement("div");

        particle.className = "particle";

        particle.style.left =
            Math.random() * 100 + "%";

        particle.style.top =
            Math.random() * 100 + "%";

        particle.style.animationDuration =
            (8 + Math.random() * 15) + "s";

        particle.style.animationDelay =
            (-Math.random() * 15) + "s";

        particle.style.opacity =
            Math.random() * .3;

        container.appendChild(particle);
    }
}


/* ==========================================
   RANDOM LIGHTNING
========================================== */

function lightningStrike() {

    const lightning =
        document.getElementById("lightning");

    lightning.classList.remove("flash");

    /*
       Force browser reflow supaya animation
       boleh dimainkan semula.
    */

    void lightning.offsetWidth;

    lightning.classList.add("flash");
}


/*
   Petir muncul secara rawak.
*/

function randomLightning() {

    const delay =
        5000 + Math.random() * 15000;

    setTimeout(() => {

        lightningStrike();

        /*
           Kadang-kadang petir kedua
           muncul selepas petir pertama.
        */

        if (Math.random() > .55) {

            setTimeout(
                lightningStrike,
                120
            );
        }

        randomLightning();

    }, delay);
}


/* ==========================================
   START
========================================== */

createParticles();

createTarget();

updateCountdown();

setInterval(
    updateCountdown,
    250
);

randomLightning();

</script>

</body>
</html>
